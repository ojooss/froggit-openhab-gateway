<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Froggit openHAB Gateway - Data View</title>
    <style>
        :root {
            color-scheme: light;
            --ink: #1b2723;
            --ink-soft: #55645d;
            --paper: #eef1ee;
            --panel: #fdfdfc;
            --line: #d7ddd8;
            --brass: #a2762f;
            --brass-ink: #6e4f1f;
            --brass-tint: #f3e9d7;
            --error: #a3372b;
            --error-tint: #f7e9e7;
            --font-display: Georgia, 'Iowan Old Style', 'Palatino Linotype', 'Book Antiqua', serif;
            --font-ui: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            padding: 3rem 1.5rem 5rem;
            background: var(--paper);
            color: var(--ink);
            font-family: var(--font-ui);
            font-size: 15px;
            line-height: 1.5;
        }

        main {
            max-width: 46rem;
            margin: 0 auto;
        }

        h1 {
            font-family: var(--font-display);
            font-weight: 400;
            font-size: 2.1rem;
            letter-spacing: 0.01em;
            margin: 0 0 0.3rem;
        }

        .lede {
            margin: 0 0 2rem;
            color: var(--ink-soft);
            max-width: 38rem;
        }

        .panel {
            background: var(--panel);
            border: 1px solid var(--line);
            border-top: 3px solid var(--brass);
            border-radius: 3px;
            padding: 1.5rem 1.75rem 1.75rem;
        }

        .query {
            display: grid;
            gap: 1.25rem;
        }

        .field-group {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.25rem;
        }

        .field label {
            display: block;
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--ink-soft);
            margin-bottom: 0.35rem;
        }

        .field input[type="text"],
        .field input[type="datetime-local"] {
            width: 100%;
            font: inherit;
            font-size: 0.95rem;
            padding: 0.5rem 0.65rem;
            border: 1px solid var(--line);
            border-radius: 3px;
            background: #fff;
            color: var(--ink);
        }

        .field input:focus-visible,
        .sink-choices input:focus-visible + label {
            outline: 2px solid var(--brass);
            outline-offset: 1px;
        }

        .field-collection {
            max-width: 16rem;
        }

        .field-collection input {
            font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
            font-size: 0.85rem;
        }

        .field-hint {
            margin: 0.35rem 0 0;
            font-size: 0.78rem;
            color: var(--ink-soft);
        }

        #data_view_search_sink {
            display: flex;
            gap: 0.6rem;
            flex-wrap: wrap;
        }

        .sink-choices input[type="radio"] {
            position: absolute;
            opacity: 0;
            width: 1px;
            height: 1px;
            margin: -1px;
            overflow: hidden;
            clip: rect(0 0 0 0);
            white-space: nowrap;
        }

        #data_view_search_sink label {
            display: inline-block;
            padding: 0.5rem 1.1rem;
            border: 1px solid var(--line);
            border-radius: 999px;
            background: #fff;
            font-size: 0.88rem;
            font-weight: 600;
            color: var(--ink-soft);
            cursor: pointer;
            transition: background 0.12s ease, color 0.12s ease, border-color 0.12s ease;
        }

        #data_view_search_sink input:checked + label {
            background: var(--brass);
            border-color: var(--brass);
            color: #fff;
        }

        .form-errors,
        .field ul {
            list-style: none;
            margin: 0.4rem 0 0;
            padding: 0;
            color: var(--error);
            font-size: 0.8rem;
        }

        .field-actions {
            display: flex;
            justify-content: flex-end;
        }

        button[type="submit"] {
            font: inherit;
            font-weight: 600;
            font-size: 0.92rem;
            padding: 0.6rem 1.6rem;
            background: var(--ink);
            color: #fff;
            border: none;
            border-radius: 3px;
            cursor: pointer;
        }

        button[type="submit"]:hover { background: var(--brass-ink); }

        .empty-state,
        .hint-box {
            margin-top: 1.75rem;
            padding: 1.25rem 1.5rem;
            border: 1px dashed var(--line);
            border-radius: 3px;
            color: var(--ink-soft);
        }

        .error-box {
            margin-top: 1.75rem;
            padding: 1rem 1.25rem;
            background: var(--error-tint);
            border: 1px solid var(--error);
            border-radius: 3px;
            color: var(--error);
        }

        .results {
            margin-top: 2rem;
        }

        .results-meta {
            font-size: 0.82rem;
            color: var(--ink-soft);
            margin: 0 0 0.6rem;
        }

        .table-scroll {
            overflow-x: auto;
            border: 1px solid var(--line);
            border-radius: 3px;
            background: var(--panel);
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.88rem;
        }

        th, td {
            padding: 0.55rem 0.9rem;
            text-align: left;
            white-space: nowrap;
        }

        thead th {
            border-bottom: 2px solid var(--ink);
            font-weight: 600;
            font-size: 0.75rem;
            color: var(--ink-soft);
        }

        tbody tr + tr td { border-top: 1px solid var(--line); }

        td.timestamp, td.value { font-variant-numeric: tabular-nums; }
        td.value { text-align: right; font-weight: 600; }

        @media (max-width: 640px) {
            .field-group { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
<main>
    <h1>Data View</h1>
    <p class="lede">Fetch raw data from the Froggit weather station from MariaDB or InfluxDB.</p>

    <div class="panel">
        {{ form_start(form, {'attr': {'class': 'query'}}) }}
            <div class="field-group">
                <div class="field">
                    {{ form_label(form.from) }}
                    {{ form_widget(form.from) }}
                    {{ form_errors(form.from) }}
                </div>
                <div class="field">
                    {{ form_label(form.to) }}
                    {{ form_widget(form.to) }}
                    {{ form_errors(form.to) }}
                </div>
            </div>

            <div class="field sink-choices">
                {{ form_label(form.sink) }}
                {% if available_sinks is empty %}
                    <p class="field-hint">No sink configured — MYSQL_URL and INFLUXDB_URL are both empty.</p>
                {% else %}
                    {{ form_widget(form.sink) }}
                {% endif %}
                {{ form_errors(form.sink) }}
            </div>

            <div class="field field-collection">
                {{ form_label(form.collection) }}
                {{ form_widget(form.collection) }}
                {{ form_errors(form.collection) }}
            </div>

            <div class="field-actions">
                {{ form_widget(form.submit) }}
            </div>
            {{ form_rest(form) }}
        {{ form_end(form) }}
    </div>

    {% if error is not null %}
        <div class="error-box">{{ error }}</div>
    {% elseif rows is null %}
        {% if not form.vars.submitted %}
            <div class="empty-state">Choose a time range and sink, then click "Show" to load readings.</div>
        {% endif %}
    {% elseif rows is empty %}
        <div class="hint-box">No readings in this time range. Widen the range or choose a different sink.</div>
    {% else %}
        <div class="results">
            <p class="results-meta">
                {{ rows|length }} {{ rows|length == 1 ? 'reading' : 'readings' }}
                from {{ search.from|date('d.m.Y H:i') }} to {{ search.to|date('d.m.Y H:i') }}
                from {{ available_sinks[search.sink] }}, newest first
            </p>
            <div class="table-scroll">
                <table>
                    <thead>
                    <tr>
                        <th>Timestamp</th>
                        <th>Device</th>
                        <th>Attribute</th>
                        <th>Value</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for row in rows %}
                        <tr>
                            <td class="timestamp">{{ row.timestamp }}</td>
                            <td>{{ row.device }}</td>
                            <td>{{ row.attribute }}</td>
                            <td class="value">{{ row.value }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
</main>
</body>
</html>
