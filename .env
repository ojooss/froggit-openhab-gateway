# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_me_in_env_local
###< symfony/framework-bundle ###

# Froggit stations report in imperial units (mph, °F, inHg, in, W/m²). By default
# FroggitService::convert() converts these to metric (m/s, °C, hPa, mm, lux) per the
# 'convert' mapping in config/services/froggit.yaml before they reach any sink.
# Set to 0/false to disable this conversion and pass the raw imperial values through
# unchanged instead — e.g. if a downstream consumer (openHAB item, Influx dashboard)
# already expects imperial units.
FROGGIT_CONVERT_ENABLED=1

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###


MYSQL_URL="mysql://$MARIADB_USER:$MARIADB_PASSWORD@mariadb:3306/$MARIADB_DATABASE?serverVersion=12.1.2-MariaDB"
MYSQL_TABLE=data

INFLUXDB_URL="http://influxdb:8086"
INFLUXDB_TOKEN=
INFLUXDB_ORG=
INFLUXDB_BUCKET=

OPENHAB_URL="http://openhab:8080"
OPENHAB_TOKEN=
